# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Never place the service-role key in web/config.js or commit it.
ALLOWED_ORIGINS=http://localhost:5173
LEAD_ENGINE_PUBLIC_SUBMISSIONS_ENABLED=false
TURNSTILE_SECRET_KEY=
ADMIN_USER_IDS=
# Public values go into web/config.js: project URL, publishable key, Turnstile site key.
